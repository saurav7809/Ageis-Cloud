# =====================================================
# AegisCloud — Environment Variables
# =====================================================
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in all values marked with CHANGE_THIS
# 3. NEVER commit your .env file to Git
# =====================================================

# --------------------------------------------------
# DATABASE (PostgreSQL)
# --------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aegiscloud
DB_USERNAME=aegiscloud
DB_PASSWORD=CHANGE_THIS_SECURE_DB_PASSWORD

# --------------------------------------------------
# REDIS
# --------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for no Redis password (local dev only)
REDIS_PASSWORD=

# --------------------------------------------------
# JWT SECURITY
# --------------------------------------------------
# Generate a secure 256-bit Base64-encoded secret:
# openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_256BIT_BASE64_ENCODED_SECRET_KEY_MIN_32_CHARS
# Token expiration in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# --------------------------------------------------
# BACKEND SERVER
# --------------------------------------------------
SERVER_PORT=8080

# --------------------------------------------------
# FRONTEND
# --------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api
FRONTEND_URL=http://localhost:5173

# --------------------------------------------------
# KUBERNETES
# --------------------------------------------------
# Context name from ~/.kube/config
K8S_CONTEXT=docker-desktop
# Set to true when running AegisCloud inside a K8s cluster
K8S_IN_CLUSTER=false
K8S_DEFAULT_NAMESPACE=aegiscloud
K8S_CONNECTION_TIMEOUT=30

# --------------------------------------------------
# AI SERVICE (Python/FastAPI - Phase 21)
# --------------------------------------------------
AI_SERVICE_URL=http://localhost:8090
AI_SERVICE_TIMEOUT=30
